# 🎵 MPV Configuration
input-ipc-server=~/.mpv-socket
keep-open=yes
save-position-on-quit=no
resume-playback=no

# Terminal / Audio (WSL, Linux, macOS, Android/Termux Resilient)
ao=pulse,alsa,opensles,audiotrack
audio-stream-silence=yes
audio-wait-open=0.2
audio-channels=stereo
volume=100
volume-max=200
gapless-audio=yes
audio-pitch-correction=yes

# Network & Streaming Reconnect Resilience
network-timeout=30
stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5
cache=yes
cache-secs=60
cache-pause=yes
cache-pause-wait=2
demuxer-max-bytes=150MiB
demuxer-max-back-bytes=50MiB
demuxer-readahead-secs=20
ytdl=yes
ytdl-format=bestvideo[height<=1440][fps>=50][format_note!*=Premium]+bestaudio/bestvideo[height<=1080][fps>=50][format_note!*=Premium]+bestaudio/bestvideo[height<=1440][format_note!*=Premium]+bestaudio/bestvideo[height<=1080][format_note!*=Premium]+bestaudio/bestvideo[fps>=50][format_note!*=Premium]+bestaudio/bestvideo[format_note!*=Premium]+bestaudio/best
script-opts=ytdl_hook-ytdl_path=yt-dlp
tls-verify=no

# Headless Audio
vo=null
video=no

[flat-audio]
af=

[dolby-like]
af=lavfi=[firequalizer=zero_phase=on:gain_entry='entry(40,4);entry(80,3);entry(160,1.5);entry(320,0.2);entry(1000,0);entry(2800,1.2);entry(6000,2);entry(12000,1.4)'],acompressor=threshold=-18dB:ratio=2.2:attack=20:release=250:makeup=3,alimiter=limit=0.97
