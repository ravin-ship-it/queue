# 🎵 MPV Configuration - Studio Quality & Zero-Stutter Streaming
input-ipc-server=~/.mpv-socket
keep-open=yes
save-position-on-quit=no
resume-playback=no

# 🎧 High-Fidelity Audio Driver & Deep Jitter Buffer (Android / WSL2 / Linux Resilient)
ao=pulse,pipewire,alsa,opensles,audiotrack
audio-buffer=1.0
pulse-buffer=300
pulse-latency-hacks=no
audio-samplerate=48000
audio-format=s16
audio-channels=stereo
volume=100
volume-max=200
gapless-audio=yes
audio-pitch-correction=yes

# 🚀 Dedicated Demuxer Thread & Heavy Readahead Cache
demuxer-thread=yes
cache=yes
cache-secs=300
demuxer-max-bytes=256MiB
demuxer-max-back-bytes=128MiB
demuxer-readahead-secs=300
demuxer-hysteresis-secs=5

# 🌐 Stream & Network Resilience
network-timeout=30
stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5
demuxer-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5
ytdl=yes
ytdl-format=bestaudio[protocol^=http]/best[protocol^=http]/bestaudio/best
script-opts=ytdl_hook-ytdl_path=yt-dlp
tls-verify=no

# 🔇 Headless Audio Performance
vo=null
video=no

[flat-audio]
af=

[dolby-like]
af=lavfi=[firequalizer=zero_phase=on:gain_entry='entry(40,4);entry(80,3);entry(160,1.5);entry(320,0.2);entry(1000,0);entry(2800,1.2);entry(6000,2);entry(12000,1.4)'],acompressor=threshold=-18dB:ratio=2.2:attack=20:release=250:makeup=3,alimiter=limit=0.97
