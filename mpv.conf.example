# 🎵 MPV Configuration
input-ipc-server=~/.mpv-socket
keep-open=yes
save-position-on-quit=no
resume-playback=no

# Terminal / Audio (WSL PulseAudio Resilient)
ao=pulse,alsa
pulse-latency-hacks=yes
pulse-buffer=100
audio-stream-silence=yes
audio-wait-open=0.2
audio-channels=stereo
volume=100
volume-max=200
gapless-audio=yes
audio-pitch-correction=yes

# Network & Streaming Reconnect Resilience
network-timeout=30
stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5
demuxer-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5
cache=yes
cache-secs=300
demuxer-max-bytes=256MiB
demuxer-max-back-bytes=128MiB
demuxer-readahead-secs=300
ytdl=yes
ytdl-format=bestaudio/best
script-opts=ytdl_hook-ytdl_path=yt-dlp
stream-buffer-size=16MiB
tls-verify=no

# Headless Audio
vo=null
video=no

[flat-audio]
af=

[dolby-like]
af=lavfi=[firequalizer=zero_phase=on:gain_entry='entry(40,4);entry(80,3);entry(160,1.5);entry(320,0.2);entry(1000,0);entry(2800,1.2);entry(6000,2);entry(12000,1.4)'],acompressor=threshold=-18dB:ratio=2.2:attack=20:release=250:makeup=3,alimiter=limit=0.97
