# 🎵 MPV Configuration
input-ipc-server=~/.mpv-socket
keep-open=yes
save-position-on-quit=no
resume-playback=no

# Terminal / Audio (macOS, Linux, WSL, Android/Termux Resilient)
ao=coreaudio,pipewire,pulse,alsa,opensles,audiotrack
pulse-latency-hacks=yes
pulse-buffer=250
audio-stream-silence=yes
audio-wait-open=0.2
audio-channels=stereo
volume=100
volume-max=200
gapless-audio=yes
audio-pitch-correction=yes

# Network & Streaming Reconnect Resilience (Zero Speed Bump / Fluid Readahead)
network-timeout=30
stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5
cache=yes
cache-secs=120
cache-pause=no
demuxer-max-bytes=256MiB
demuxer-max-back-bytes=64MiB
demuxer-readahead-secs=60
ytdl=yes
ytdl-format=bestvideo[height<=1440][fps>=50][vcodec^=avc1][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=1440][fps>=50][vcodec^=vp9][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=1080][fps>=50][vcodec^=avc1][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=1080][fps>=50][vcodec^=vp9][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=720][fps>=50][vcodec^=avc1][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=720][fps>=50][vcodec^=vp9][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=1440][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=1080][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[height<=720][format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo[format_note!*=Premium]+bestaudio[acodec=opus]/bestvideo+bestaudio/best
script-opts=ytdl_hook-ytdl_path=yt-dlp
ytdl-raw-options=extractor-args="youtube:player_client=android,web"
tls-verify=no

# Desktop Video & Window Behavior
autofit=50%x50%
geometry=50%:50%
auto-window-resize=no
keepaspect-window=no
cursor-autohide=1000

# GPU Hardware Acceleration & 60fps Smoothness Optimization
vo=gpu
gpu-context=wayland,auto
profile=fast
hwdec=auto-safe
opengl-pbo=yes
swapchain-depth=3
video-sync=audio
vd-lavc-threads=0

# Headless Audio
vo=null
video=no

[flat-audio]
af=

[dolby-like]
af=lavfi=[firequalizer=zero_phase=on:gain_entry='entry(40,4);entry(80,3);entry(160,1.5);entry(320,0.2);entry(1000,0);entry(2800,1.2);entry(6000,2);entry(12000,1.4)'],acompressor=threshold=-18dB:ratio=2.2:attack=20:release=250:makeup=3,alimiter=limit=0.97
