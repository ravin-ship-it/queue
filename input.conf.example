# MPV Keybindings for Queue Video Mode
F11 cycle fullscreen
f cycle fullscreen
CLOSE_WIN quit
Alt+F4 quit
q quit
Q quit
Ctrl+w quit
Ctrl+W quit
Meta+w quit
Meta+W quit
Meta+q quit
Meta+Q quit
h script-message safe-hide-video
H script-message safe-hide-video
ESC set fullscreen no
> playlist-next
< playlist-prev
SPACE cycle pause

# Window Sizing & Scaling (Quick Resizing)
w cycle_values window-scale 0.35 0.5 0.75 1.0 ; show-text "Window Scale: ${window-scale}" 1500
W cycle_values window-scale 1.0 0.75 0.5 0.35 ; show-text "Window Scale: ${window-scale}" 1500
+ add window-scale 0.05 ; show-text "Window Scale: ${window-scale}" 1500
= add window-scale 0.05 ; show-text "Window Scale: ${window-scale}" 1500
- add window-scale -0.05 ; show-text "Window Scale: ${window-scale}" 1500
_ add window-scale -0.05 ; show-text "Window Scale: ${window-scale}" 1500
Ctrl+WHEEL_UP add window-scale 0.05 ; show-text "Window Scale: ${window-scale}" 1500
Ctrl+WHEEL_DOWN add window-scale -0.05 ; show-text "Window Scale: ${window-scale}" 1500

# Quick Quality / Resolution Switchers (Seamless position memory & smart adaptive)
0 script-message change-quality auto
1 script-message change-quality low
2 script-message change-quality mid
3 script-message change-quality high
4 script-message change-quality max

KP0 script-message change-quality auto
KP1 script-message change-quality low
KP2 script-message change-quality mid
KP3 script-message change-quality high
KP4 script-message change-quality max

Ctrl+0 script-message change-quality auto
Ctrl+1 script-message change-quality low
Ctrl+2 script-message change-quality mid
Ctrl+3 script-message change-quality high
Ctrl+4 script-message change-quality max

F1 script-message change-quality auto
F2 script-message change-quality low
F3 script-message change-quality mid
F4 script-message change-quality high
F5 script-message change-quality max

# Audio Language Switcher (YouTube Multi-Audio Dubs & Multi-Track Audio)
a script-message cycle-language
A script-message cycle-language
# script-message cycle-language

Ctrl+s cycle shuffle
r playlist-shuffle
